{
  "name": "chef-vip",
  "version": "1.0.0",
  "private": true,
  "description": "Kitchen board for Shabour - prep sheet, orders, recipe book, cleaning, HACCP, waste and transfers.",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "job:daily": "node src/jobs/run.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "test:e2e": "node test/e2e.js",
    "test:all": "npm test && npm run test:e2e && npm run test:boot && npm run test:ordering && npm run test:welcome && npm run test:haccp && npm run test:ui",
    "test:haccp": "node test/haccp.js",
    "test:boot": "node test/boot.js",
    "test:ordering": "node test/ordering.js",
    "test:ui": "node test/ui.js",
    "test:welcome": "node test/welcome.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "playwright": "1.49"
  }
}
