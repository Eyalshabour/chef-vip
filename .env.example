# --- required ---
DATABASE_URL=postgres://user:pass@host:5432/chefvip
SESSION_SECRET=change-me-to-a-long-random-string

# --- optional ---
PORT=3000
NODE_ENV=development

# Melba. The key is on your Melba profile (Settings -> user -> API).
# Read server-side so chef and sous see the numbers without their own account.
MELBA_API_KEY=
MELBA_API_BASE=https://api.melba.io
# ^ CONFIRM THIS. Melba's MCP endpoint is https://mcp.melba.io/mcp; the REST base
#   is not something I could verify from here. Check it before trusting the numbers.

# Daily jobs (Europe/Paris). Leave RUN_JOBS unset to disable.
RUN_JOBS=1
JOB_MORNING=17 8 * * 2-6
JOB_EVENING=41 15 * * 2-6
